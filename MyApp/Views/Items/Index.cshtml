@model List<Item>
@{
	ViewData["Title"] = "Index";
}
<h3 style="text-align:center">Index</h3>

<a style="margin: 0 auto; display: block;" asp-action="ShowForm" class="btn btn-primary">Create</a>

<br />

@if(Model.Count == 0)
{
	<h3 style="text-align:center">No items found</h3>
} else
{
	<table style="margin:0 auto; border: 1px solid #ddd; border-collapse: collapse; width: 100%; text-align: center;">
		<tr style="padding: 10px; border: 1px solid #ddd;">
			<th style="padding: 10px; border: 1px solid #ddd;">Name</th>
			<th style="padding: 10px; border: 1px solid #ddd;">Price</th>
			<th style="padding: 10px; border: 1px solid #ddd;">Serial Number</th>
			<th style="padding: 10px; border: 1px solid #ddd;">Category</th>
			<th style="padding: 10px; border: 1px solid #ddd;">Client</th>
		</tr>

		@foreach (var item in Model)
		{
			<tr>
				<td style="padding: 10px; border: 1px solid #ddd;">@item.Name</td>
				<td style="padding: 10px; border: 1px solid #ddd;">@item.Price/=</td>
				<td style="padding: 10px; border: 1px solid #ddd;">@item.SerialNumber?.Number</td>
				<td style="padding: 10px; border: 1px solid #ddd;">@item.Category?.Name</td>
				<td style="padding: 10px; border: 1px solid #ddd;">
					@foreach (var client in item.ItemClients)
					{
						@client.Client?.Name
					}
				</td>
				<td>
					<a asp-action="ShowForm" asp-route-id="@item.Id" class="btn btn-primary">Edit</a>
				</td>
				<td>
					<a asp-action="ConfirmDialog" asp-route-id="@item.Id" class="btn btn-danger">Delete</a>
				</td>
			</tr>
		}
	</table>
}
